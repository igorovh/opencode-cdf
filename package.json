{
  "name": "opencode-cdf",
  "version": "0.2.1",
  "description": "OpenCode TUI plugin: a /cdf picker for favorite project directories that moves the session or opens a new one",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v2",
    "opencode-tui",
    "tui",
    "opentui",
    "projects",
    "favorites",
    "project-switcher"
  ],
  "license": "MIT",
  "author": "igorovh",
  "homepage": "https://github.com/igorovh/opencode-cdf#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorovh/opencode-cdf.git"
  },
  "bugs": {
    "url": "https://github.com/igorovh/opencode-cdf/issues"
  },
  "type": "module",
  "packageManager": "bun@1.4.4",
  "private": true,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "scripts": {
    "compile": "bun scripts/compile.ts",
    "check:dist": "bun scripts/check-dist.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.5",
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.7",
    "@opentui/core": "0.8.4",
    "@opentui/solid": "0.8.4",
    "@types/bun": "1.4.4",
    "solid-js": "1.9.19",
    "typescript": "7.0.2"
  }
}
